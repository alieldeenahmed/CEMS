<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests that need a real PostgreSQL server: the parts of the system where SQLite (used by the fast
    suites) behaves differently or cannot be used at all: real migrations, exclusion/check constraints,
    advisory locks, timestamptz, and genuinely concurrent requests.
    They fail (they are not skipped) when no server is reachable; see the README Testing section for how to provide one.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="9.0.20" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CEMS.Api.Tests\CEMS.Api.Tests.csproj" />
  </ItemGroup>

</Project>
