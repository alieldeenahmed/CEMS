# Copy to `.env` (git-ignored) to override the defaults below. Docker Compose reads `.env` automatically.
# EVERY VALUE HERE IS A DEVELOPMENT DEFAULT FOR LOCAL DEMOS ONLY. Never reuse any of them anywhere real.

# --- PostgreSQL container (docker-compose.yml, service "postgres") -------------------------------
POSTGRES_USER=cems
POSTGRES_PASSWORD=cems_dev_password
POSTGRES_DB=cems
# Host port the container's 5432 is published on. Change it if you already run PostgreSQL locally.
POSTGRES_PORT=5432

# --- API container (docker-compose.yml, profile "app") ---------------------------------------------
# HMAC signing key for JWTs. The API refuses to start if it is under 32 bytes. Generate a real one with:
#   openssl rand -base64 48
JWT_KEY=dev-only-insecure-key-replace-me-0123456789abcdef
# Host port for the API (container listens on 8080). 5272 matches `dotnet run`'s http profile.
API_PORT=5272
# Browser origin allowed by CORS (the Vite dev server by default).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Running the API on the host instead of in Docker ----------------------------------------------
# These are the names ASP.NET Core and `dotnet ef` read. Export them in your shell (or use
# `dotnet user-secrets` for the API; `dotnet ef` needs the environment variable, see README).
#   ConnectionStrings__Default=Host=localhost;Port=5432;Database=cems;Username=cems;Password=cems_dev_password
#   Jwt__Key=<same value as JWT_KEY>
#   Cors__AllowedOrigins__0=http://localhost:5173
